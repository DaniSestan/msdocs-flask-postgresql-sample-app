[alembic]
# The alembic.ini file is truncated and contains only database configuration and logging configuration to be compatible with the pyproject template of alembic.
# Note that it's better to store the database connection string/url in an env file; if an env file is stored in the code repository it needs to be included in the .gitignore. Credentials, typically, should not be hard-coded in env file. When the application is running on a server within an internal 'network' on the cloud, an api call, using Python for Azure, can be used to access any database credentials stored on Azure resources. This is the 'recommended' approach, provided that access to any accounts storing those resources isn't compromised.

# Logging configuration
[loggers]
; keys = root,sqlalchemy,alembic,flask_migrate
keys = root

[handlers]
keys = console_out,console_err,file_root_out
; keys = console_out,console_err
# keys = console_out,console_err,file_root_out,file_root_err,file_sqlalchemy_out,file_sqlalchemy_err,file_alembic_out,file_alembic_err,file_flask_migrate_out,file_flask_migrate_err

[formatters]
keys = generic

[logger_root]
level = WARNING
; handlers = console_err
handlers = handler_file_root_out
qualname =

; [logger_sqlalchemy]
; level = WARNING
; handlers = handler_file_sqlalchemy_err
; qualname = sqlalchemy.engine
;
; [logger_alembic]
; level = INFO
; handlers =
; qualname = alembic
;
; [logger_flask_migrate]
; level = INFO
; handlers =
; qualname = flask_migrate

[handler_console_out]
class = StreamHandler
args = (sys.stdout,)
level = NOTSET
formatter = generic

[handler_console_err]
class = StreamHandler
args = (sys.stderr,)
level = NOTSET
formatter = generic

# leave levels as not set unless something needs to be customized; loggers have a level key that the level defaults to;
# Note: The filenames specified in the handler args need to be created in the project root dir prior to running the alembic init command:

[handler_file_root_out]
class = FileHandler
args=('root_out.log')
; args=('%(logfilename)s','a',)
level = NOTSET
formatter = generic
;
; [handler_file_root_err]
; class = FileHandler
; args = (root_err.log)
; level = NOTSET
; formatter = generic
;
; [handler_file_sqlalchemy_out]
; class = FileHandler
; args = (sqlalchemy_out.log)
; level = NOTSET
; formatter = generic
;
; [handler_file_sqlalchemy_err]
; class = FileHandler
; args = (sqlalchemy_err.log)
; level = NOTSET
; formatter = generic
;
; [handler_file_alembic_out]
; class = FileHandler
; args = (alembic_out.log)
; level = NOTSET
; formatter = generic
;
; [handler_file_alembic_err]
; class = FileHandler
; args = (alembic_err.log)
; level = NOTSET
; formatter = generic
;
; [handler_file_flask_migrate_out]
; class = FileHandler
; args = (flask_migrate_out.log)
; level = NOTSET
; formatter = generic
;
; [handler_file_flask_migrate_err]
; class = FileHandler
; args = (flask_migrate_err.log)
; level = NOTSET
; formatter = generic

[formatter_generic]
format = %(levelname)-5.5s [%(name)s] %(message)s
datefmt = %H:%M:%S
